<script>

    // ─── API CONFIGURATION ─────────────────────────────────────────
    const API_BASE_URL = 'http://localhost:8080/api'; // Change to your Java server

    // ─── API HELPER FUNCTIONS ──────────────────────────────────────
    async function apiCall(endpoint, options = {}) {
        try {
            const url = `${API_BASE_URL}${endpoint}`;
            const response = await fetch(url, {
                ...options,
                headers: {
                    'Content-Type': 'application/json',
                    ...(options.headers || {})
                }
            });
            
            const data = await response.json();
            return { success: response.ok, data };
        } catch (error) {
            console.error('API Error:', error);
            return { success: false, error: error.message };
        }
    }

    // ─── CHECK LOGIN ──────────────────────────────────────────────
    const savedUser = localStorage.getItem("memoryLinkUser");
    if (!savedUser) window.location.replace("/login");
    let user = null;
    try { user = JSON.parse(savedUser); } catch { localStorage.removeItem("memoryLinkUser"); window.location.replace("/login"); }
    if (user && user.role !== "admin") window.location.replace("/strands");
    if (user) {
        document.getElementById("userName").textContent = user.username || "Admin";
        document.getElementById("userRole").textContent = "Administrator";
        document.getElementById("userAvatar").textContent = (user.username || "A").charAt(0).toUpperCase();
    }

    // ─── GET URL PARAMETERS ────────────────────────────────────────
    function getURLParameter(name) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
    }

    // ─── STRANDS ──────────────────────────────────────────────────
    async function getStrands() {
        const result = await apiCall('/strands');
        if (result.success && Array.isArray(result.data)) {
            return result.data;
        }
        return ["STEM A", "STEM B", "ABM", "HUMSS", "GAS", "TVL", "Arts and Design"];
    }

    async function populateStrandDropdown() {
        const select = document.getElementById('lessonCategory');
        if (!select) return;
        
        while (select.options.length > 1) {
            select.remove(1);
        }
        
        const strands = await getStrands();
        strands.forEach(function(strand) {
            const option = document.createElement('option');
            option.value = strand;
            option.textContent = strand;
            select.appendChild(option);
        });
    }

    // ─── LESSONS FROM API ──────────────────────────────────────────
    async function getLessons() {
        const result = await apiCall(`/lessons?username=${encodeURIComponent(user ? user.username : 'admin')}&isAdmin=true`);
        if (result.success && Array.isArray(result.data)) {
            return result.data;
        }
        return [];
    }

    async function saveApprovedLessons(lessons) {
        // For admin, we need to save to the database via API
        // This is handled by the individual operations (approve, delete, edit)
        // The API already handles persistence
        return true;
    }

    async function savePendingLessons(pending) {
        // For admin, pending lessons are managed via API
        // The API already handles persistence
        return true;
    }

    async function saveRejectedLessons(rejected) {
        // For admin, rejected lessons are managed via API
        // The API already handles persistence
        return true;
    }

    // ─── CREATE SUB LESSONS ──────────────────────────────────────
    function createSubLessons(lesson) {
        const result = [];
        const count = lesson.numberOfLessons || 0;
        for (let i = 1; i <= count; i++) {
            let content = "This is the learning content for Lesson " + i + " of " + lesson.title + ".";
            if (lesson.subLessons && lesson.subLessons[i - 1] && lesson.subLessons[i - 1].content) {
                const existingContent = lesson.subLessons[i - 1].content;
                if (!existingContent.includes("The administrator can later add")) {
                    content = existingContent;
                }
            }
            result.push({
                title: "Lesson " + i,
                content: content
            });
        }
        return result;
    }

    // ─── DISPLAY LESSONS ────────────────────────────────────────────
    let currentTab = 'all';
    let currentFilter = null;
    let allLessonsCache = [];

    async function displayLessons() {
        allLessonsCache = await getLessons();
        const search = document.getElementById("searchInput").value.toLowerCase().trim();

        let filtered = allLessonsCache;

        // Apply tab filter
        if (currentTab === 'pending') {
            filtered = filtered.filter(function(l) { return l.status === 'pending'; });
        } else if (currentTab === 'approved') {
            filtered = filtered.filter(function(l) { return l.status === 'approved'; });
        } else if (currentTab === 'rejected') {
            filtered = filtered.filter(function(l) { return l.status === 'rejected'; });
        }

        // Apply search
        if (search) {
            filtered = filtered.filter(function(lesson) {
                return lesson.title.toLowerCase().includes(search) ||
                    lesson.category.toLowerCase().includes(search) ||
                    lesson.description.toLowerCase().includes(search);
            });
        }

        // Apply strand filter
        if (currentFilter) {
            filtered = filtered.filter(function(lesson) {
                return lesson.category === currentFilter;
            });
        }

        const grid = document.getElementById("lessonGrid");
        const empty = document.getElementById("emptyState");
        const emptyMsg = document.getElementById("emptyMessage");

        grid.innerHTML = "";

        if (filtered.length === 0) {
            empty.style.display = "flex";
            if (currentTab === 'pending') {
                emptyMsg.textContent = "No pending lessons from students. All clear!";
            } else if (currentTab === 'rejected') {
                emptyMsg.textContent = "No rejected lessons.";
            } else if (currentTab === 'approved') {
                emptyMsg.textContent = "No approved lessons yet.";
            } else {
                emptyMsg.textContent = "Add a new lesson to get started.";
            }
        } else {
            empty.style.display = "none";
            filtered.forEach(function(lesson) {
                const card = document.createElement("div");
                card.className = "lesson-card";
                if (lesson.status === 'pending') card.classList.add("pending-card");
                if (lesson.status === 'rejected') card.classList.add("rejected-card");

                const isPending = lesson.status === 'pending';
                const isRejected = lesson.status === 'rejected';
                const isApproved = lesson.status === 'approved';

                card.innerHTML = `
                    <div class="lesson-cover">
                        <i class="${getIcon(lesson.category)}"></i>
                        <span class="category-badge">${escapeHTML(lesson.category)}</span>
                        <span class="status-badge ${lesson.status}">${escapeHTML(lesson.status)}</span>
                    </div>
                    <div class="lesson-content">
                        <h4>${escapeHTML(lesson.title)}</h4>
                        <p>${escapeHTML(lesson.description)}</p>
                        <div class="lesson-meta">
                            <span><i class="fa-regular fa-clock"></i> ${escapeHTML(lesson.duration)} min</span>
                            <span><i class="fa-solid fa-book"></i> ${lesson.numberOfLessons} lessons</span>
                            ${lesson.submittedBy ? `<span><i class="fa-solid fa-user"></i> ${escapeHTML(lesson.submittedBy)}</span>` : ''}
                        </div>
                        <div class="card-actions">
                            ${isPending ? `
                                <button class="approve-btn" onclick="approveLesson(${lesson.id})">
                                    <i class="fa-solid fa-check"></i> Approve
                                </button>
                                <button class="decline-btn" onclick="declineLesson(${lesson.id})">
                                    <i class="fa-solid fa-xmark"></i> Decline
                                </button>
                            ` : ''}
                            ${isApproved ? `
                                <button class="edit-btn" onclick="editLesson(${lesson.id})">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </button>
                            ` : ''}
                            ${isRejected ? `
                                <button class="edit-btn" onclick="editLesson(${lesson.id})">
                                    <i class="fa-solid fa-pen"></i> Edit & Resubmit
                                </button>
                            ` : ''}
                            <button class="delete-btn" onclick="confirmDeleteLesson(${lesson.id})">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                `;

                // Only make clickable for viewing content if approved
                if (isApproved) {
                    card.addEventListener("click", function(event) {
                        if (event.target.closest(".card-actions")) return;
                        openLessonSelector(lesson.id);
                    });
                } else {
                    // For pending/rejected, clicking opens the reading modal for viewing
                    card.addEventListener("click", function(event) {
                        if (event.target.closest(".card-actions")) return;
                        // Open the reading modal to view content
                        openReadingModal(lesson.id, 0);
                    });
                }

                grid.appendChild(card);
            });
        }

        // Update stats
        const allLessons = await getLessons();
        document.getElementById("totalLessons").textContent = allLessons.length;
        document.getElementById("pendingCount").textContent = allLessons.filter(function(l) { return l.status === 'pending'; }).length;
        document.getElementById("rejectedCount").textContent = allLessons.filter(function(l) { return l.status === 'rejected'; }).length;
        document.getElementById("approvedCount").textContent = allLessons.filter(function(l) { return l.status === 'approved'; }).length;

        // Update badges
        document.getElementById("allBadge").textContent = allLessons.length;
        document.getElementById("pendingBadge").textContent = allLessons.filter(function(l) { return l.status === 'pending'; }).length;
        document.getElementById("approvedBadge").textContent = allLessons.filter(function(l) { return l.status === 'approved'; }).length;
        document.getElementById("rejectedBadge").textContent = allLessons.filter(function(l) { return l.status === 'rejected'; }).length;

        document.getElementById("lessonCount").textContent = filtered.length + (filtered.length === 1 ? " lesson" : " lessons");

        updateFilterBadge();
        updatePageHeader();
    }

    function getIcon(category) {
        if (category === "STEM A") return "fa-solid fa-atom";
        if (category === "STEM B") return "fa-solid fa-flask";
        return "fa-solid fa-book-open";
    }

    function escapeHTML(value) {
        return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    // ─── TABS ──────────────────────────────────────────────────────
    function switchTab(tab) {
        currentTab = tab;
        document.querySelectorAll('.tab-btn').forEach(function(btn) {
            btn.classList.remove('active');
            if (btn.dataset.tab === tab) {
                btn.classList.add('active');
            }
        });
        displayLessons();
    }

    // ─── FILTER ────────────────────────────────────────────────────
    function updateFilterBadge() {
        const container = document.getElementById("filterBadgeContainer");
        if (currentFilter) {
            container.innerHTML = `
                <div class="filter-badge">
                    <i class="fa-solid fa-filter"></i>
                    ${escapeHTML(currentFilter)}
                    <button class="clear-filter" onclick="clearFilter()" title="Remove filter">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            `;
        } else {
            container.innerHTML = "";
        }
    }

    function updatePageHeader() {
        const title = document.getElementById("pageTitle");
        const desc = document.getElementById("pageDescription");
        if (currentFilter) {
            title.textContent = currentFilter + " Lessons";
            desc.textContent = 'Showing lessons for "' + currentFilter + '" strand. Review pending submissions and manage approved lessons.';
        } else if (currentTab === 'pending') {
            title.textContent = "Pending Lessons";
            desc.textContent = "Review lessons submitted by students. Approve or decline each submission.";
        } else if (currentTab === 'rejected') {
            title.textContent = "Rejected Lessons";
            desc.textContent = "Lessons that were declined. You can edit and resubmit them.";
        } else if (currentTab === 'approved') {
            title.textContent = "Approved Lessons";
            desc.textContent = "All approved lessons available for students.";
        } else {
            title.textContent = "Lessons Manager";
            desc.textContent = "Create and manage learning lessons for your students. Review pending submissions from students.";
        }
    }

    function setFilter(strand) {
        currentFilter = strand;
        document.getElementById("searchInput").value = "";
        displayLessons();
    }

    function clearFilter() {
        currentFilter = null;
        document.getElementById("searchInput").value = "";
        displayLessons();
    }

    function loadFilterFromURL() {
        const strandParam = getURLParameter("strand");
        if (strandParam) {
            const strands = getStrands();
            strands.then(function(list) {
                if (list.includes(strandParam)) {
                    setFilter(strandParam);
                }
            });
            return true;
        }
        return false;
    }

    // ─── APPROVE / DECLINE LESSONS ──────────────────────────────
    async function approveLesson(id) {
        const lesson = (await getLessons()).find(function(l) { return l.id === id; });
        if (!lesson) return;

        openConfirmModal(
            "Approve Lesson",
            'Are you sure you want to <strong>approve</strong> the lesson "<strong>' + escapeHTML(lesson.title) + '</strong>"? It will become available to students.',
            async function() {
                const result = await apiCall(`/lessons/${id}/approve`, {
                    method: 'PUT',
                    body: JSON.stringify({ admin: user ? user.username : 'admin' })
                });
                if (result.success) {
                    displayLessons();
                } else {
                    alert('Failed to approve lesson. Please try again.');
                }
            },
            null
        );
    }

    async function declineLesson(id) {
        const lesson = (await getLessons()).find(function(l) { return l.id === id; });
        if (!lesson) return;

        openConfirmModal(
            "Decline Lesson",
            'Are you sure you want to <strong>decline</strong> the lesson "<strong>' + escapeHTML(lesson.title) + '</strong>"? The student will be notified.',
            async function() {
                const result = await apiCall(`/lessons/${id}/reject`, {
                    method: 'PUT',
                    body: JSON.stringify({ 
                        admin: user ? user.username : 'admin',
                        reason: 'Declined by admin'
                    })
                });
                if (result.success) {
                    displayLessons();
                } else {
                    alert('Failed to decline lesson. Please try again.');
                }
            },
            null
        );
    }

    // ─── MODAL CONTROL ────────────────────────────────────────────
    let editingId = null;

    function openModal() {
        editingId = null;
        document.getElementById("modalTitle").textContent = "Add Lesson";
        document.getElementById("lessonForm").reset();
        document.getElementById("lessonForm").dataset.editId = "";
        document.getElementById("lessonModal").classList.add("show");
        document.getElementById("lessonTitle").focus();
        populateStrandDropdown();
    }

    function closeModal() {
        document.getElementById("lessonModal").classList.remove("show");
        editingId = null;
    }

    document.getElementById("lessonForm").addEventListener("submit", async function(event) {
        event.preventDefault();

        const title = document.getElementById("lessonTitle").value.trim();
        const category = document.getElementById("lessonCategory").value;
        const description = document.getElementById("lessonDescription").value.trim();
        const duration = Number(document.getElementById("lessonDuration").value);
        const numberOfLessons = Number(document.getElementById("lessonNumber").value);

        if (!title || !category || !description || !duration || !numberOfLessons) {
            alert("Please complete all fields.");
            return;
        }
        if (duration < 1 || duration > 30) {
            alert("Lesson duration must be between 1 and 30 minutes.");
            return;
        }

        const editId = this.dataset.editId;
        const isEdit = !!editId;
        
        // Create sublessons
        const subLessons = [];
        for (let i = 1; i <= numberOfLessons; i++) {
            subLessons.push({
                title: "Lesson " + i,
                content: "This is the learning content for Lesson " + i + " of " + title + "."
            });
        }

        const lessonData = {
            title: title,
            category: category,
            description: description,
            duration: duration,
            numberOfLessons: numberOfLessons,
            subLessons: subLessons,
            submittedBy: user ? user.username : 'admin'
        };

        const actionText = isEdit ? "update" : "create";
        const lessonTitle = title;
        openConfirmModal(
            isEdit ? "Update Lesson" : "Create New Lesson",
            'Are you sure you want to <strong>' + actionText + '</strong> the lesson "<strong>' + escapeHTML(lessonTitle) + '</strong>"?',
            async function(data) {
                await saveLessonData(data, isEdit, editId);
            },
            lessonData
        );
    });

    async function saveLessonData(data, isEdit, editId) {
        let result;
        if (isEdit) {
            result = await apiCall(`/lessons/${editId}`, {
                method: 'PUT',
                body: JSON.stringify(data)
            });
        } else {
            result = await apiCall('/lessons', {
                method: 'POST',
                body: JSON.stringify(data)
            });
        }

        if (result.success) {
            closeModal();
            displayLessons();
        } else {
            alert('Failed to save lesson. Please try again.');
        }
    }

    async function editLesson(id) {
        const lessons = await getLessons();
        const lesson = lessons.find(function(item) { return item.id === id; });
        if (!lesson) return;

        editingId = id;
        document.getElementById("modalTitle").textContent = "Edit Lesson";
        document.getElementById("lessonTitle").value = lesson.title;
        document.getElementById("lessonCategory").value = lesson.category;
        document.getElementById("lessonDescription").value = lesson.description;
        document.getElementById("lessonDuration").value = lesson.duration;
        document.getElementById("lessonNumber").value = lesson.numberOfLessons;
        document.getElementById("lessonForm").dataset.editId = id;
        document.getElementById("lessonModal").classList.add("show");
        await populateStrandDropdown();
        document.getElementById("lessonCategory").value = lesson.category;
    }

    async function confirmDeleteLesson(id) {
        const lessons = await getLessons();
        const lesson = lessons.find(function(item) { return item.id === id; });
        if (!lesson) return;

        openConfirmModal(
            "Delete Lesson",
            'Are you sure you want to permanently delete the lesson "<strong>' + escapeHTML(lesson.title) + '</strong>"? This action cannot be undone.',
            async function(lessonId) {
                const result = await apiCall(`/lessons/${lessonId}`, {
                    method: 'DELETE'
                });
                if (result.success) {
                    displayLessons();
                } else {
                    alert('Failed to delete lesson. Please try again.');
                }
            },
            id
        );
    }

    // ─── LESSON SELECTOR ──────────────────────────────────────────
    let selectedLessonId = null;
    let currentSubLessonIndex = 0;
    let isEditMode = false;

    async function openLessonSelector(id) {
        const lessons = await getLessons();
        const lesson = lessons.find(function(item) { return item.id === id; });
        if (!lesson || lesson.status !== 'approved') {
            if (lesson) {
                openReadingModal(id, 0);
            }
            return;
        }

        selectedLessonId = id;
        lesson.subLessons = createSubLessons(lesson);

        document.getElementById("selectorTitle").textContent = lesson.title;
        document.getElementById("selectorDescription").textContent = lesson.description;

        const grid = document.getElementById("lessonNumberGrid");
        grid.innerHTML = "";

        lesson.subLessons.forEach(function(subLesson, index) {
            const item = document.createElement("div");
            item.className = "lesson-number-item";
            const hasContent = subLesson.content && subLesson.content.length > 50 && !subLesson.content.includes("The administrator can later add");
            const statusClass = hasContent ? "has-content" : "empty";
            const statusText = hasContent ? "✓ Has Content" : "✗ Empty";
            item.innerHTML = `
                <div class="lesson-number-icon">${index + 1}</div>
                <div class="lesson-number-text">
                    <strong>Lesson ${index + 1}</strong>
                    <span>${escapeHTML(subLesson.title)} <span class="sublesson-status ${statusClass}">${statusText}</span></span>
                </div>
            `;
            item.addEventListener("click", function() {
                openReadingModal(id, index);
            });
            grid.appendChild(item);
        });

        document.getElementById("lessonSelectorModal").classList.add("show");
    }

    function closeLessonSelector() {
        document.getElementById("lessonSelectorModal").classList.remove("show");
    }

    // ─── RICH TEXT EDITOR FUNCTIONS ──────────────────────────────
    function formatText(command, value) {
        if (!isEditMode) return;
        
        const editor = document.getElementById("lessonContentEditor");
        editor.focus();
        
        if (command === 'formatBlock') {
            document.execCommand(command, false, value);
        } else {
            document.execCommand(command, false, null);
        }
        
        updateToolbarState();
    }

    function updateToolbarState() {
        const toolbarButtons = document.querySelectorAll('#editorToolbar button');
        toolbarButtons.forEach(function(btn) {
            const cmd = btn.getAttribute('onclick');
            if (cmd) {
                const match = cmd.match(/formatText\('([^']+)'/);
                if (match) {
                    const command = match[1];
                    try {
                        if (document.queryCommandState(command)) {
                            btn.classList.add('active');
                        } else {
                            btn.classList.remove('active');
                        }
                    } catch(e) {
                        btn.classList.remove('active');
                    }
                }
            }
        });
    }

    // ─── READING / EDIT MODAL ────────────────────────────────────
    async function openReadingModal(lessonId, subLessonIndex) {
        const lessons = await getLessons();
        const lesson = lessons.find(function(item) { return item.id === lessonId; });
        if (!lesson) return;

        lesson.subLessons = createSubLessons(lesson);
        selectedLessonId = lessonId;
        currentSubLessonIndex = subLessonIndex;
        isEditMode = false;

        document.getElementById("lessonSelectorModal").classList.remove("show");
        renderReadingLesson();
    }

    function renderReadingLesson() {
        const lessons = getLessons();
        const lesson = lessons.find(function(item) { return item.id === selectedLessonId; });
        if (!lesson) return;

        lesson.subLessons = createSubLessons(lesson);
        const current = lesson.subLessons[currentSubLessonIndex];
        if (!current) return;

        document.getElementById("readingCategory").textContent = lesson.category;
        document.getElementById("readingTitle").textContent = current.title;
        document.getElementById("readingProgressText").textContent = "Lesson " + (currentSubLessonIndex + 1) + " of " + lesson.subLessons.length;

        const progress = ((currentSubLessonIndex + 1) / lesson.subLessons.length) * 100;
        document.getElementById("readingProgressBar").style.width = progress + "%";

        const editor = document.getElementById("lessonContentEditor");
        editor.innerHTML = current.content;
        editor.contentEditable = "false";
        editor.style.background = "#fafbfe";

        document.getElementById("prevLessonBtn").disabled = currentSubLessonIndex === 0;
        document.getElementById("nextLessonBtn").disabled = currentSubLessonIndex === lesson.subLessons.length - 1;

        const editSaveBtn = document.getElementById("editSaveBtn");
        editSaveBtn.innerHTML = '<i class="fa-solid fa-pen"></i> Edit';
        editSaveBtn.className = "edit-save-btn";
        isEditMode = false;

        document.querySelectorAll('#editorToolbar button').forEach(function(btn) {
            btn.classList.remove('active');
        });

        document.getElementById("readingModal").classList.add("show");
        document.getElementById("readingBody").scrollTop = 0;
    }

    function toggleEditSave() {
        const editor = document.getElementById("lessonContentEditor");
        const btn = document.getElementById("editSaveBtn");

        if (!isEditMode) {
            editor.contentEditable = "true";
            editor.style.background = "white";
            editor.focus();
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Save';
            btn.className = "edit-save-btn save-mode";
            isEditMode = true;
        } else {
            const content = editor.innerHTML.trim();
            if (!content || content === '<br>') {
                alert("Please enter the lesson content.");
                return;
            }

            const lesson = getLessons().find(function(item) { return item.id === selectedLessonId; });
            const lessonTitle = lesson ? lesson.title : "Lesson";
            openConfirmModal(
                "Save Content",
                'Are you sure you want to save the content for "<strong>' + escapeHTML(lessonTitle) + ' - ' + escapeHTML(editor.innerText.substring(0, 50)) + '...</strong>"?',
                function() {
                    saveLessonContent(editor.innerHTML);
                },
                editor.innerHTML
            );
        }
    }

    async function saveLessonContent(content) {
        // Get the lesson first to know its current status
        const lessons = await getLessons();
        const lesson = lessons.find(function(item) { return item.id === selectedLessonId; });
        if (!lesson) return;

        // Update sublessons
        const subLessons = createSubLessons(lesson);
        if (currentSubLessonIndex !== null && subLessons[currentSubLessonIndex]) {
            subLessons[currentSubLessonIndex].content = content;
        }

        const lessonData = {
            ...lesson,
            subLessons: subLessons
        };
        delete lessonData.status; // Remove status as it's not needed for update

        const result = await apiCall(`/lessons/${selectedLessonId}`, {
            method: 'PUT',
            body: JSON.stringify(lessonData)
        });

        if (result.success) {
            const editor = document.getElementById("lessonContentEditor");
            const btn = document.getElementById("editSaveBtn");
            editor.contentEditable = "false";
            editor.style.background = "#fafbfe";
            btn.innerHTML = '<i class="fa-solid fa-pen"></i> Edit';
            btn.className = "edit-save-btn";
            isEditMode = false;

            // Refresh the view
            renderReadingLesson();
            displayLessons();
        } else {
            alert('Failed to save lesson content. Please try again.');
        }
    }

    function previousLesson() {
        if (currentSubLessonIndex <= 0) return;
        
        if (isEditMode) {
            openConfirmModal(
                "Unsaved Changes",
                'You have unsaved changes. Do you want to save before moving to the previous lesson?',
                function() {
                    const editor = document.getElementById("lessonContentEditor");
                    const content = editor.innerHTML.trim();
                    if (content && content !== '<br>') {
                        saveLessonContent(content);
                    }
                    currentSubLessonIndex--;
                    renderReadingLesson();
                }
            );
            return;
        }
        
        currentSubLessonIndex--;
        renderReadingLesson();
    }

    function nextLesson() {
        const lessons = getLessons();
        const lesson = lessons.find(function(item) { return item.id === selectedLessonId; });
        if (!lesson) return;
        lesson.subLessons = createSubLessons(lesson);
        if (currentSubLessonIndex >= lesson.subLessons.length - 1) return;
        
        if (isEditMode) {
            openConfirmModal(
                "Unsaved Changes",
                'You have unsaved changes. Do you want to save before moving to the next lesson?',
                function() {
                    const editor = document.getElementById("lessonContentEditor");
                    const content = editor.innerHTML.trim();
                    if (content && content !== '<br>') {
                        saveLessonContent(content);
                    }
                    currentSubLessonIndex++;
                    renderReadingLesson();
                }
            );
            return;
        }
        
        currentSubLessonIndex++;
        renderReadingLesson();
    }

    function backToLessonSelector() {
        if (isEditMode) {
            openConfirmModal(
                "Unsaved Changes",
                'You have unsaved changes. Do you want to save before going back?',
                function() {
                    const editor = document.getElementById("lessonContentEditor");
                    const content = editor.innerHTML.trim();
                    if (content && content !== '<br>') {
                        saveLessonContent(content);
                    }
                    document.getElementById("readingModal").classList.remove("show");
                    isEditMode = false;
                    const lesson = getLessons().find(function(item) { return item.id === selectedLessonId; });
                    if (lesson && lesson.status === 'approved') {
                        openLessonSelector(selectedLessonId);
                    } else {
                        displayLessons();
                    }
                }
            );
            return;
        }
        document.getElementById("readingModal").classList.remove("show");
        isEditMode = false;
        const lesson = getLessons().find(function(item) { return item.id === selectedLessonId; });
        if (lesson && lesson.status === 'approved') {
            openLessonSelector(selectedLessonId);
        } else {
            displayLessons();
        }
    }

    function closeReadingModal() {
        if (isEditMode) {
            openConfirmModal(
                "Unsaved Changes",
                'You have unsaved changes. Do you want to save before closing?',
                function() {
                    const editor = document.getElementById("lessonContentEditor");
                    const content = editor.innerHTML.trim();
                    if (content && content !== '<br>') {
                        saveLessonContent(content);
                    }
                    document.getElementById("readingModal").classList.remove("show");
                    isEditMode = false;
                }
            );
            return;
        }
        document.getElementById("readingModal").classList.remove("show");
        isEditMode = false;
    }

    // ─── CONFIRM MODAL ────────────────────────────────────────────
    let confirmCallback = null;
    let confirmData = null;

    function openConfirmModal(title, message, callback, data) {
        document.getElementById("confirmTitle").textContent = title || "Confirm";
        document.getElementById("confirmMessage").innerHTML = message || "Are you sure you want to proceed?";
        confirmCallback = callback;
        confirmData = data;
        document.getElementById("confirmModal").classList.add("show");
    }

    function closeConfirmModal() {
        document.getElementById("confirmModal").classList.remove("show");
        confirmCallback = null;
        confirmData = null;
    }

    document.getElementById("confirmActionBtn").addEventListener("click", function() {
        if (confirmCallback) {
            confirmCallback(confirmData);
        }
        closeConfirmModal();
    });

    // ─── SIDEBAR ──────────────────────────────────────────────────
    const sidebar = document.getElementById("sidebar");
    const main = document.getElementById("main");
    const sidebarToggle = document.getElementById("sidebarToggle");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    sidebarToggle.addEventListener("click", function() {
        if (window.innerWidth <= 750) {
            sidebar.classList.toggle("show");
            sidebarOverlay.classList.toggle("show");
        } else {
            sidebar.classList.toggle("collapsed");
            main.classList.toggle("expanded");
        }
    });

    sidebarOverlay.addEventListener("click", function() {
        sidebar.classList.remove("show");
        sidebarOverlay.classList.remove("show");
    });

    document.querySelectorAll(".sidebar-link").forEach(function(link) {
        link.addEventListener("click", function() {
            if (window.innerWidth <= 750) {
                sidebar.classList.remove("show");
                sidebarOverlay.classList.remove("show");
            }
        });
    });

    // ─── MODAL CLOSE ON OVERLAY ──────────────────────────────────
    document.getElementById("lessonModal").addEventListener("click", function(event) {
        if (event.target === this) closeModal();
    });
    document.getElementById("lessonSelectorModal").addEventListener("click", function(event) {
        if (event.target === this) closeLessonSelector();
    });
    document.getElementById("readingModal").addEventListener("click", function(event) {
        if (event.target === this) closeReadingModal();
    });

    document.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
            if (document.getElementById("confirmModal").classList.contains("show")) {
                return;
            }
            closeModal();
            closeLessonSelector();
            closeReadingModal();
        }
    });

    // ─── LOGOUT ──────────────────────────────────────────────────
    document.getElementById("logoutButton").addEventListener("click", function(event) {
        event.preventDefault();
        localStorage.removeItem("memoryLinkUser");
        window.location.replace("/login");
    });

    // ─── SEED DEMO DATA ────────────────────────────────────────────
    async function seedDemoData() {
        const lessons = await getLessons();
        if (lessons.length === 0) {
            // Create default lessons via API
            const defaultLessons = [
                { title: "ENGLISH 201", category: "STEM A", description: "English language and literature studies.", duration: 25, numberOfLessons: 5, submittedBy: "admin" },
                { title: "SOC 101", category: "STEM A", description: "Introduction to society and culture.", duration: 25, numberOfLessons: 10, submittedBy: "admin" },
                { title: "Introduction to Programming", category: "STEM B", description: "Basic programming concepts.", duration: 25, numberOfLessons: 8, submittedBy: "admin" }
            ];

            for (const lesson of defaultLessons) {
                const subLessons = [];
                for (let i = 1; i <= lesson.numberOfLessons; i++) {
                    subLessons.push({
                        title: "Lesson " + i,
                        content: "This is the learning content for Lesson " + i + " of " + lesson.title + "."
                    });
                }
                lesson.subLessons = subLessons;
                await apiCall('/lessons', {
                    method: 'POST',
                    body: JSON.stringify(lesson)
                });
            }

            // Add a sample pending lesson
            const samplePending = {
                title: "Sample Student Lesson",
                category: "STEM A",
                description: "This is a lesson submitted by a student for approval.",
                duration: 20,
                numberOfLessons: 3,
                subLessons: [
                    { title: "Lesson 1", content: "<b>Introduction</b> to the topic." },
                    { title: "Lesson 2", content: "<i>Key concepts</i> and definitions." },
                    { title: "Lesson 3", content: "<u>Summary</u> and review." }
                ],
                submittedBy: "student_user"
            };
            await apiCall('/lessons', {
                method: 'POST',
                body: JSON.stringify(samplePending)
            });
        }
        displayLessons();
    }

    // ─── INIT ────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function() {
        populateStrandDropdown();
        const hasFilter = loadFilterFromURL();
        seedDemoData();
    });

</script>

