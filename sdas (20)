<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Lessons | MemoryLink</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; height: 100%; overflow: hidden; }
        body { font-family: "Segoe UI", Arial, sans-serif; background: #f4f7fc; color: #1e293b; }
        a { text-decoration: none; }

        .dashboard-container { display: flex; width: 100%; height: 100vh; overflow: hidden; }

        .sidebar {
            width: 250px; height: 100vh;
            background: linear-gradient(180deg, #051650 0%, #0a2368 55%, #18347d 100%);
            color: white; position: fixed; left: 0; top: 0;
            padding: 18px 17px; display: flex; flex-direction: column;
            z-index: 9999; overflow: hidden;
            transition: width 0.3s ease, padding 0.3s ease, transform 0.3s ease;
        }
        .sidebar.collapsed { width: 82px; padding: 18px 12px; }

        .sidebar-top {
            width: 100%; display: flex; align-items: center; gap: 10px;
            padding: 0 3px 16px; border-bottom: 1px solid rgba(255,255,255,0.12);
            margin-bottom: 20px;
        }
        .sidebar-toggle {
            width: 40px; height: 40px; min-width: 40px;
            border: none; border-radius: 10px;
            background: rgba(255,255,255,0.10); color: white;
            display: flex; align-items: center; justify-content: center;
            font-size: 17px; cursor: pointer; transition: 0.25s;
        }
        .sidebar-toggle:hover { background: rgba(255,255,255,0.18); transform: translateY(-1px); }

        .user-profile { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; }
        .user-avatar {
            width: 40px; height: 40px; min-width: 40px;
            border-radius: 50%; background: white; color: #051650;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; font-weight: 800;
        }
        .user-info { min-width: 0; overflow: hidden; transition: opacity 0.2s ease, width 0.3s ease; }
        .user-info strong { display: block; color: white; font-size: 13px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 3px; }
        .user-info span { color: rgba(255,255,255,0.55); font-size: 10px; }

        .sidebar.collapsed .sidebar-top { flex-direction: column; gap: 14px; padding-left: 0; padding-right: 0; }
        .sidebar.collapsed .sidebar-toggle { order: 1; }
        .sidebar.collapsed .user-profile { order: 2; flex: none; justify-content: center; width: 100%; }
        .sidebar.collapsed .user-info { width: 0; opacity: 0; pointer-events: none; }

        .menu-title { color: rgba(255,255,255,0.45); font-size: 10px; font-weight: 700; letter-spacing: 1px; padding: 0 12px; margin-bottom: 10px; white-space: nowrap; transition: opacity 0.2s ease; }
        .sidebar.collapsed .menu-title { opacity: 0; height: 0; margin-bottom: 4px; }

        .menu { display: flex; flex-direction: column; gap: 6px; width: 100%; }
        .menu a, .sidebar-bottom a {
            width: 100%; color: rgba(255,255,255,0.72);
            display: flex; align-items: center; gap: 13px;
            padding: 13px 14px; border-radius: 12px;
            font-size: 13px; font-weight: 600;
            transition: background 0.25s ease, color 0.25s ease, transform 0.15s ease;
            cursor: pointer; white-space: nowrap;
        }
        .menu a i, .sidebar-bottom a i { width: 20px; min-width: 20px; text-align: center; font-size: 15px; }
        .menu a:hover, .sidebar-bottom a:hover { background: rgba(255,255,255,0.10); color: white; transform: translateX(2px); }
        .menu a.active { background: rgba(255,255,255,0.16); color: white; box-shadow: inset 3px 0 0 white; }

        .sidebar.collapsed .menu a, .sidebar.collapsed .sidebar-bottom a { justify-content: center; padding-left: 0; padding-right: 0; gap: 0; }
        .sidebar.collapsed .menu a:hover, .sidebar.collapsed .sidebar-bottom a:hover { transform: none; }
        .sidebar.collapsed .menu a span, .sidebar.collapsed .sidebar-bottom a span { display: none; }

        .sidebar-bottom { margin-top: auto; padding-top: 15px; width: 100%; }
        .sidebar-bottom a { margin-top: 5px; }

        .main {
            margin-left: 250px; width: calc(100% - 250px); height: 100vh;
            padding: 0 35px 20px; overflow: hidden;
            display: flex; flex-direction: column;
            transition: margin-left 0.3s ease, width 0.3s ease;
        }
        .main.expanded { margin-left: 82px; width: calc(100% - 82px); }

        .site-header {
            height: 49px; min-height: 49px;
            margin-left: -35px; margin-right: -35px;
            padding: 0 25px; background: #051650;
            display: flex; align-items: center; justify-content: space-between;
            color: white; flex-shrink: 0;
        }
        .school-name { font-size: 21px; font-weight: 800; }
        .memory-link-title { font-size: 21px; font-weight: 800; letter-spacing: 0.3px; }

        .dashboard-content {
            flex: 1; display: flex; flex-direction: column; min-height: 0;
            overflow-y: auto; overflow-x: hidden; padding-right: 2px;
        }
        .dashboard-content::-webkit-scrollbar { width: 5px; }
        .dashboard-content::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        .welcome-card {
            flex: 0 0 170px; border-radius: 22px; padding: 27px 30px;
            color: white; background: linear-gradient(135deg, #051650, #0a2368, #18347d);
            position: relative; overflow: hidden; margin-top: 18px; margin-bottom: 16px;
            box-shadow: 0 15px 35px rgba(5,22,80,0.18);
        }
        .welcome-card::before { content: ""; position: absolute; width: 280px; height: 280px; border: 2px solid rgba(255,255,255,0.08); border-radius: 50%; right: -80px; top: -130px; }
        .welcome-card::after { content: ""; position: absolute; width: 190px; height: 190px; border: 2px solid rgba(255,255,255,0.07); border-radius: 50%; right: 110px; bottom: -135px; }
        .welcome-content { position: relative; z-index: 2; }
        .badge { display: inline-flex; align-items: center; gap: 7px; padding: 6px 11px; background: rgba(255,255,255,0.12); border-radius: 20px; font-size: 10px; font-weight: 700; margin-bottom: 9px; }
        .welcome-content h2 { font-size: 25px; margin-bottom: 6px; }
        .welcome-content p { color: rgba(255,255,255,0.78); font-size: 13px; max-width: 700px; line-height: 1.5; }

        .action-bar {
            display: flex; justify-content: space-between; align-items: center;
            gap: 15px; margin-bottom: 16px; flex-shrink: 0;
        }
        .search-box { flex: 1; max-width: 400px; position: relative; }
        .search-box i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
        .search-box input { width: 100%; height: 42px; padding: 0 15px 0 43px; border: 1px solid #e2e8f0; background: white; border-radius: 12px; outline: none; font-size: 13px; }
        .search-box input:focus { border-color: #051650; box-shadow: 0 0 0 3px rgba(5,22,80,0.08); }
        .add-btn {
            height: 42px; padding: 0 20px; border: none; border-radius: 12px;
            background: linear-gradient(135deg, #051650, #18347d);
            color: white; font-weight: 700; cursor: pointer;
            display: flex; align-items: center; gap: 9px;
            box-shadow: 0 8px 18px rgba(5,22,80,0.20); transition: 0.25s; flex-shrink: 0;
        }
        .add-btn:hover { transform: translateY(-2px); }

        .filter-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #eef2ff;
            color: #051650;
            padding: 6px 14px 6px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            flex-shrink: 0;
        }
        .filter-badge .clear-filter {
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            font-size: 14px;
            padding: 0 2px;
        }
        .filter-badge .clear-filter:hover { color: #dc2626; }

        .lesson-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 16px;
            flex-shrink: 0;
        }
        .stat-card {
            background: white;
            border-radius: 17px;
            padding: 17px 18px;
            min-height: 100px;
            box-shadow: 0 5px 20px rgba(5,22,80,0.06);
            border: 1px solid #edf1f7;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .stat-icon {
            width: 45px; height: 45px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            background: #eef2ff;
            color: #051650;
            font-size: 18px;
            flex-shrink: 0;
        }
        .stat-card h3 { color: #64748b; font-size: 11px; font-weight: 600; margin-bottom: 3px; }
        .stat-number { color: #051650; font-size: 25px; font-weight: 800; }
        .stat-card.pending .stat-icon { background: #dbeafe; color: #2563eb; }
        .stat-card.rejected .stat-icon { background: #fee2e2; color: #dc2626; }

        .panel {
            background: white;
            border-radius: 18px;
            padding: 20px;
            border: 1px solid #edf1f7;
            box-shadow: 0 5px 20px rgba(5,22,80,0.05);
            flex: 1;
            min-height: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            flex-shrink: 0;
        }
        .panel-header h3 { color: #051650; font-size: 16px; font-weight: 800; }
        .panel-header span { color: #94a3b8; font-size: 11px; }

        .tab-bar {
            display: flex;
            gap: 4px;
            margin-bottom: 15px;
            flex-shrink: 0;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 4px;
        }
        .tab-btn {
            padding: 8px 18px;
            border: none;
            background: transparent;
            color: #94a3b8;
            font-weight: 700;
            font-size: 12px;
            cursor: pointer;
            border-radius: 8px 8px 0 0;
            transition: 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .tab-btn:hover { background: #f1f5f9; color: #1e293b; }
        .tab-btn.active { color: #051650; background: #eef2ff; }
        .tab-btn .badge-count {
            background: #e2e8f0;
            color: #64748b;
            padding: 0 7px;
            border-radius: 10px;
            font-size: 10px;
        }
        .tab-btn.active .badge-count { background: #051650; color: white; }
        .tab-btn.pending-tab .badge-count { background: #dbeafe; color: #2563eb; }
        .tab-btn.pending-tab.active .badge-count { background: #2563eb; color: white; }
        .tab-btn.rejected-tab .badge-count { background: #fee2e2; color: #dc2626; }
        .tab-btn.rejected-tab.active .badge-count { background: #dc2626; color: white; }

        .lesson-grid-wrapper {
            flex: 1;
            overflow-y: auto;
            padding-right: 2px;
        }
        .lesson-grid-wrapper::-webkit-scrollbar { width: 5px; }
        .lesson-grid-wrapper::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        .lesson-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }
        .lesson-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #edf1f7;
            box-shadow: 0 5px 20px rgba(5,22,80,0.05);
            transition: 0.25s;
            cursor: pointer;
        }
        .lesson-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(5,22,80,0.10);
        }
        .lesson-card.pending-card {
            border-left: 5px solid #2563eb;
            background: #f8faff;
        }
        .lesson-card.rejected-card {
            border-left: 5px solid #dc2626;
            background: #fff8f8;
        }
        .lesson-cover {
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #eef2ff, #e8edff);
            color: #051650;
            position: relative;
        }
        .lesson-cover i { font-size: 35px; }
        .category-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #051650;
            color: white;
            padding: 4px 9px;
            border-radius: 20px;
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
        }
        .status-badge {
            position: absolute;
            top: 10px;
            right: 10px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-badge.pending { background: #dbeafe; color: #2563eb; }
        .status-badge.rejected { background: #fee2e2; color: #dc2626; }
        .status-badge.approved { background: #dcfce7; color: #16a34a; }
        .lesson-content { padding: 16px 18px 18px; }
        .lesson-content h4 { color: #051650; font-size: 14px; margin-bottom: 6px; }
        .lesson-content p { color: #64748b; font-size: 11px; line-height: 1.5; min-height: 32px; margin-bottom: 12px; }
        .lesson-meta {
            display: flex;
            justify-content: space-between;
            color: #94a3b8;
            font-size: 10px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f1f5f9;
            flex-wrap: wrap;
            gap: 4px;
        }
        .lesson-meta span { display: flex; align-items: center; gap: 4px; }
        .card-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
        .edit-btn, .delete-btn, .approve-btn, .decline-btn {
            flex: 1; height: 36px; border: none; border-radius: 9px;
            font-size: 10px; font-weight: 700; cursor: pointer;
            transition: 0.2s; display: flex; align-items: center; justify-content: center; gap: 5px;
            min-width: 60px;
        }
        .edit-btn { background: #eef2ff; color: #051650; }
        .delete-btn { background: #fff1f2; color: #dc2626; }
        .approve-btn { background: #dcfce7; color: #16a34a; }
        .decline-btn { background: #fee2e2; color: #dc2626; }
        .edit-btn:hover, .delete-btn:hover, .approve-btn:hover, .decline-btn:hover { transform: translateY(-1px); }

        .empty-state {
            display: none;
            text-align: center;
            padding: 50px 20px;
            color: #94a3b8;
            flex: 1;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        .empty-state i { font-size: 40px; margin-bottom: 15px; color: #cbd5e1; }
        .empty-state h3 { color: #64748b; font-size: 15px; margin-bottom: 5px; }
        .empty-state p { font-size: 11px; }

        /* ─── MODAL STYLES ─── */
        .modal {
            display: none;
            position: fixed; inset: 0;
            background: rgba(15,23,42,0.55);
            backdrop-filter: blur(4px);
            align-items: center; justify-content: center;
            z-index: 99999;
            padding: 20px;
        }
        .modal.show { display: flex; }
        .modal-box {
            width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto;
            background: white; border-radius: 20px; padding: 28px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.18);
            animation: modalIn 0.2s ease;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: translateY(10px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
        }
        .modal-header h2 { color: #051650; font-size: 20px; }
        .close-btn {
            width: 34px; height: 34px; border: none;
            background: #f1f5f9; color: #64748b;
            border-radius: 9px; cursor: pointer;
        }
        .close-btn:hover { background: #e2e8f0; }

        .form-group { margin-bottom: 17px; }
        .form-group label { display: block; color: #334155; font-size: 12px; font-weight: 700; margin-bottom: 7px; }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            border: 1px solid #e2e8f0;
            border-radius: 11px;
            padding: 11px 13px;
            font-family: inherit;
            font-size: 13px;
            outline: none;
        }
        .form-group textarea { resize: vertical; min-height: 80px; }
        .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
            border-color: #051650;
            box-shadow: 0 0 0 3px rgba(5,22,80,0.08);
        }
        .field-hint { display: block; color: #94a3b8; font-size: 10px; margin-top: 5px; }
        .duration-wrapper { position: relative; }
        .duration-wrapper input { padding-right: 65px; }
        .duration-unit {
            position: absolute;
            right: 13px; top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
            pointer-events: none;
        }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px; }
        .cancel-btn, .save-btn, .confirm-btn {
            height: 42px; padding: 0 18px; border-radius: 10px;
            cursor: pointer; font-weight: 700; font-size: 12px;
        }
        .cancel-btn { border: 1px solid #e2e8f0; background: white; color: #64748b; }
        .cancel-btn:hover { background: #f8fafc; }
        .save-btn { border: none; background: #051650; color: white; }
        .save-btn:hover { background: #0a2368; }
        .confirm-btn { border: none; background: #dc2626; color: white; }
        .confirm-btn:hover { background: #b91c1c; }
        .confirm-btn.approve { background: #16a34a; }
        .confirm-btn.approve:hover { background: #15803d; }

        .confirm-modal-box { 
            max-width: 420px; 
            text-align: center; 
            padding: 32px 28px 28px;
        }
        .confirm-modal-box .modal-header { 
            justify-content: center; 
            margin-bottom: 12px;
            border-bottom: none;
        }
        .confirm-modal-box .modal-header h2 { 
            font-size: 20px; 
            color: #051650;
        }
        .confirm-modal-box .modal-header .close-btn {
            display: none;
        }
        .confirm-message { 
            color: #475569; 
            font-size: 14px; 
            margin-bottom: 28px; 
            line-height: 1.7;
            padding: 0 5px;
        }
        .confirm-message strong { color: #051650; }
        .confirm-actions { 
            display: flex; 
            justify-content: center; 
            gap: 12px; 
        }
        .confirm-actions .cancel-btn { 
            min-width: 110px; 
            padding: 0 20px;
            height: 44px;
        }
        .confirm-actions .confirm-btn { 
            min-width: 110px; 
            padding: 0 20px;
            height: 44px;
        }

        .lesson-selector-box { max-width: 620px; }
        .selector-info {
            background: #f4f7ff;
            border: 1px solid #e4e9ff;
            border-radius: 14px;
            padding: 15px;
            margin-bottom: 18px;
        }
        .selector-info h3 { color: #051650; font-size: 16px; margin-bottom: 4px; }
        .selector-info p { color: #64748b; font-size: 11px; line-height: 1.5; }

        .lesson-number-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 3px;
        }
        .lesson-number-grid::-webkit-scrollbar { width: 5px; }
        .lesson-number-grid::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        .lesson-number-item {
            border: 1px solid #e6ebf3;
            background: white;
            border-radius: 13px;
            padding: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: 0.2s;
            text-align: left;
        }
        .lesson-number-item:hover { border-color: #051650; background: #f7f9ff; transform: translateY(-1px); }
        .lesson-number-icon {
            width: 38px; height: 38px; min-width: 38px;
            border-radius: 10px; background: #eef2ff; color: #051650;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 13px;
        }
        .lesson-number-text { min-width: 0; }
        .lesson-number-text strong { display: block; color: #051650; font-size: 12px; margin-bottom: 3px; }
        .lesson-number-text span { display: block; color: #94a3b8; font-size: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sublesson-status {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 8px;
            font-weight: 700;
            margin-left: 5px;
        }
        .sublesson-status.has-content { background: #dcfce7; color: #166534; }
        .sublesson-status.empty { background: #fef3c7; color: #92400e; }

        .reading-modal-box { max-width: 820px; padding: 0; overflow: hidden; }
        .reading-header {
            padding: 22px 25px;
            background: linear-gradient(135deg, #051650, #0a2368, #18347d);
            color: white;
            position: relative;
        }
        .reading-header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }
        .reading-category {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,0.12);
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 700;
        }
        .reading-header h2 { font-size: 21px; margin-top: 12px; line-height: 1.3; }
        .reading-progress-text { color: rgba(255,255,255,0.65); font-size: 10px; margin-top: 5px; }
        .reading-close {
            width: 35px; height: 35px; border: none;
            background: rgba(255,255,255,0.12); color: white;
            border-radius: 9px; cursor: pointer; flex-shrink: 0;
        }
        .reading-close:hover { background: rgba(255,255,255,0.20); }
        .reading-progress { height: 4px; background: rgba(255,255,255,0.12); }
        .reading-progress-bar { height: 100%; width: 10%; background: white; transition: width 0.25s ease; }

        .reading-body { padding: 28px; max-height: 55vh; overflow-y: auto; }
        .reading-body::-webkit-scrollbar { width: 5px; }
        .reading-body::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }

        .editor-toolbar {
            display: flex;
            gap: 4px;
